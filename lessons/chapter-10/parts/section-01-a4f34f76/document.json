{
  "type": "doc",
  "content": [
    {
      "type": "paragraph",
      "content": [
        {
          "text": "This chapter/section will cover the common う words in Okinawan to remember at this level.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "っうぃーん or っうぃーゆん - to plant",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "ういん or うゆん - to buy",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うぅーむん - male",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うぅじゃさ - father or mother's older brother",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うぅばまー - aunt",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うぅんちゅー - father or mother's younger brother",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うたいん or うたゆん - to sing",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うてぃーん or うてぃゆん - to fall",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うとぅ - sound/noise",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うとぅげー - lower jaw (antonym of かくじ - upper jaw)",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うとぅすん - to drop",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うびーん or うびゆん - to remember",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "うふっちゅ - adult",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Reminder that うぃ is pronounced wi and うぅ is pronounced wu.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        }
      ]
    },
    {
      "type": "paragraph"
    }
  ]
}
