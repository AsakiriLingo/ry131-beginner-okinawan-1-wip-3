{
  "type": "doc",
  "content": [
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Here are some extra common words you should know for the exam starting with う, お, か",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "間数（えーじゅー）= fellow/companion/buddy/comrade",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "おーいん / おーゆん / おーえーすん = to fight",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "かーらちゅん = to dry",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "鏡（かがん）= mirror",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "かくじ = upper jaw",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "数（かじゅ）いん / 数（かじゅ）ゆん = to count",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "勝（か）ちゅん = to win",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "絡（から）みーん / 絡（から）みゆん = to catch (as in capture/arrest)",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "被（かん）じゅん = to wear (on the head)",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph"
    }
  ]
}
