{
  "format": "asakiri-course",
  "formatVersion": 2,
  "type": "doc",
  "content": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Useful words beginning with \"w\" and \"n\" わ　うぃ　うぅ　うぇ　を　ん"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "っわー = pig"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "わかりーん or わかりゆん = to split or to divorce"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "忘（わし）ーん or 忘（わし）ゆん = to forget"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "笑（わら）いん or 笑（わら）ゆん = to laugh"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "っうぇーきんちゅ = rich person"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "っうぇんちゅ = mouse"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "んじ = thorn"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "っんじゅちゅん = to move"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "味噌（んす）= miso (take of seasoning in Japan and Okinawa)"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "胸（んに）= chest"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "稲（っんに）= rice plant"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "馬（っんま）= horse"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "生（っん）まりーん or 生（っん）まりゆん = to be born"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "んーちゅ or んちゅ = 2 years ago, the year before previous"
        }
      ]
    }
  ]
}
