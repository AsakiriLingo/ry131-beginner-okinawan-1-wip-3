  "content": [
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Going to somewhere with extra stuff",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            },
            {
              "type": "underline"
            }
          ]
        },
        {
          "type": "hardBreak"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "When something temporal (i.e., time related) is in a sentence, it comes before the entire sentence.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "しぐ",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            },
            {
              "type": "underline"
            }
          ]
        },
        {
          "text": "、やー(ん)かい　けーいん。 (To return home soon / I am returning home soon).",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "ちゅー",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            },
            {
              "type": "underline"
            }
          ]
        },
        {
          "text": "、やー(ん)かい　けーいん。(To return home today / I am returning home today).",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "なー",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            },
            {
              "type": "underline"
            }
          ]
        },
        {
          "text": "、やー(ん)かい　けーいん。(To return home already / I am returning home already).",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "いちか",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            },
            {
              "type": "underline"
            }
          ]
        },
        {
          "text": "、やー(ん)かい　けーいん。(To return home some day / I am returning home some day).",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "めーなち",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            },
            {
              "type": "underline"
            }
          ]
        },
        {
          "text": "、やー(ん)かい　けーいん。(To return home every day / I return home every day).",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "なま",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            },
            {
              "type": "underline"
            }
          ]
        },
        {
          "text": "、やー(ん)かい　けーいん。(To return home now / I return home now).",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "けーいん is to return (somewhere) and alternative spelling/pronunciation is けーゆん.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "やー in this context is home/house.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "しぐ means soon/immediately.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "ちゅー means today.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "なー means already, but since this relates to time in this sentence, this is put at the front.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "いちか means some day.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "めーなち means every day. めーにち is an alternate spelling.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "なま means today. いま is an alternate spelling.",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph"
    },
    {
      "type": "paragraph"
    }
  ]
}
