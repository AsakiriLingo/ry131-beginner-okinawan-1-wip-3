{
  "type": "doc",
  "content": [
    {
      "type": "paragraph",
      "content": [
        {
          "text": "This is on the い words:",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Reminder that いぃ is \"yi\".",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "いーん or っゆん - to say",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "いぃー - handle (usually for non-weaponry use). Also note that there are other meanings of this word, but this is definition recommended in this lesson.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "いぃら or いぃだ - branch",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "いちゅく - cousin (note here that many learns mistake it as いとぅく, but that is not correct)",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "いみ - dream",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "いらな - sickle/scythe (usually the meaning of sickle is more common because of farming and all).",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "いり - west (reminder like in the last lesson, it is the reverse of あがり - east)",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "いんちゃさん - short (in length, not in height)",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph"
    }
  ]
}
